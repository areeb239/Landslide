# ─── Firebase ─────────────────────────────────────────────────────────────────
# Path to your Firebase Admin SDK service account JSON file
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# Your Firebase project ID (found in Firebase Console → Project Settings)
FIREBASE_PROJECT_ID=your-firebase-project-id

# ─── FastAPI Server ────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development   # development | production

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins (use * for development)
ALLOWED_ORIGINS=*

# ─── ML Model ─────────────────────────────────────────────────────────────────
# Path to your friend's trained model file (joblib/pickle)
# Leave empty to use the built-in rule-based mock predictor
ML_MODEL_PATH=

# ─── Weather ──────────────────────────────────────────────────────────────────
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
